{
    "targets": {
        "swap": {},
        "blur_h": {
            "width": 640,
            "height": 360
        },
        "blur_v": {
            "width": 640,
            "height": 360
        },
        "next_state": {
            "width": 3,
            "height": 1
        },
        "animation": {
            "width": 3,
            "height": 1,
            "persistent": true,
            "clear_color": 0
        },
        "scene_small": {
            "width": 640,
            "height": 360
        }
    },
    "passes": [
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "lbc:post/zoom_state",
            "inputs": [
                {
                    "sampler_name": "History",
                    "target": "animation"
                }
            ],
            "output": "next_state"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/blit",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "next_state"
                }
            ],
            "output": "animation",
            "uniforms": {
                "BlitConfig": [
                    {
                        "name": "ColorModulate",
                        "type": "vec4",
                        "value": [
                            1.0,
                            1.0,
                            1.0,
                            1.0
                        ]
                    }
                ]
            }
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "lbc:post/scope_downsample",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "minecraft:main",
                    "bilinear": true
                }
            ],
            "output": "scene_small"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "lbc:post/scope_blur",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "scene_small",
                    "bilinear": true
                }
            ],
            "output": "blur_h",
            "uniforms": {
                "BlurConfig": [
                    {
                        "name": "BlurDir",
                        "type": "vec2",
                        "value": [
                            1.0,
                            0.0
                        ]
                    },
                    {
                        "name": "Radius",
                        "type": "float",
                        "value": 1.0
                    }
                ]
            }
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "lbc:post/scope_blur",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "blur_h",
                    "bilinear": true
                }
            ],
            "output": "blur_v",
            "uniforms": {
                "BlurConfig": [
                    {
                        "name": "BlurDir",
                        "type": "vec2",
                        "value": [
                            0.0,
                            1.0
                        ]
                    },
                    {
                        "name": "Radius",
                        "type": "float",
                        "value": 1.0
                    }
                ]
            }
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "lbc:post/zoom",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "minecraft:main"
                },
                {
                    "sampler_name": "Animation",
                    "target": "animation"
                },
                {
                    "sampler_name": "Blur",
                    "target": "blur_v",
                    "bilinear": true
                }
            ],
            "output": "swap",
            "uniforms": {
                "ZoomConfig": [
                    {
                        "name": "Direction",
                        "type": "float",
                        "value": 1.0
                    },
                    {
                        "name": "Duration",
                        "type": "float",
                        "value": 0.25
                    },
                    {
                        "name": "Style",
                        "type": "float",
                        "value": 0.0
                    },
                    {
                        "name": "VerticalFov",
                        "type": "float",
                        "value": 70.0
                    }
                ]
            }
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/blit",
            "inputs": [
                {
                    "sampler_name": "In",
                    "target": "swap"
                }
            ],
            "output": "minecraft:main",
            "uniforms": {
                "BlitConfig": [
                    {
                        "name": "ColorModulate",
                        "type": "vec4",
                        "value": [
                            1.0,
                            1.0,
                            1.0,
                            1.0
                        ]
                    }
                ]
            }
        }
    ]
}
